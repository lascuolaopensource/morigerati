# Environment
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# Payload CMS
DATABASE_URI=mongodb://mongo_user:mongo_password@localhost:27017
PAYLOAD_SECRET=

# Minio (S3 Storage)
S3_ENDPOINT=http://localhost:9000 # Minio endpoint
S3_BUCKET=morigerati # You need to create this bucket in Minio
S3_ACCESS_KEY_ID=minio_root_user # In production, you should use a dedicated key id
S3_SECRET_ACCESS_KEY=minio_root_password # In production, you should use a dedicated access key
S3_REGION="us-east-1" # Fake region

# MongoDB (Database)
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_password