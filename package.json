{
  "name": "morigerati",
  "version": "1.0.0",
  "description": "Transluoghi - Ecomuseo del Bussento Contemporaneo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "reset": "npm run payload generate:importmap && npm run payload generate:types",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "knip": "knip"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.45.0",
    "@payloadcms/next": "^3.45.0",
    "@payloadcms/plugin-seo": "^3.45.0",
    "@payloadcms/richtext-lexical": "^3.45.0",
    "@payloadcms/storage-s3": "^3.45.0",
    "@payloadcms/translations": "^3.45.0",
    "@payloadcms/ui": "^3.45.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/leaflet-gpx": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "graphql": "^16.10.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet-gpx": "^2.1.2",
    "lucide-react": "^0.447.0",
    "next": "^15.3.0",
    "next-intl": "^4.0.2",
    "payload": "^3.45.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-leaflet": "5.0.0",
    "react-photo-album": "^3.1.0",
    "react-social-icons": "^6.24.0",
    "react-spinners": "^0.17.0",
    "sharp": "0.32.6",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "yet-another-react-lightbox": "^3.23.2",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.14.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.3.0",
    "knip": "^5.61.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
