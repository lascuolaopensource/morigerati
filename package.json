{
  "name": "morigerati",
  "version": "1.0.0",
  "description": "Transluoghi - Ecomuseo del Bussento Contemporaneo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "reset": "npm run payload generate:importmap && npm run payload generate:types",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down"
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.3.4",
    "@payloadcms/db-mongodb": "latest",
    "@payloadcms/next": "latest",
    "@payloadcms/plugin-seo": "latest",
    "@payloadcms/richtext-lexical": "latest",
    "@payloadcms/storage-s3": "latest",
    "@payloadcms/translations": "latest",
    "@payloadcms/ui": "latest",
    "@svgr/webpack": "^8.1.0",
    "@types/react-modal": "^3.16.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "graphql": "^16.10.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet-geosearch": "^4.2.0",
    "leaflet-gpx": "^2.1.2",
    "lucide-react": "^0.447.0",
    "next": "^15.3.0",
    "next-intl": "^4.0.2",
    "payload": "latest",
    "photoswipe": "^5.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-masonry-css": "^1.0.16",
    "react-modal": "^3.16.3",
    "react-photo-album": "^3.1.0",
    "react-photoswipe-gallery": "^3.1.1",
    "react-player": "^2.16.0",
    "react-social-icons": "^6.24.0",
    "sharp": "0.32.6",
    "swiper": "^11.2.6",
    "tailwind-merge": "^3.2.0",
    "video.js": "^8.22.0",
    "yet-another-react-lightbox": "^3.23.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.3.0",
    "postcss": "^8.5.3",
    "react-video-thumbnail": "^0.1.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
