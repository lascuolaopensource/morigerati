{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/app/(site)/[locale]/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "#/components",
    "utils": "#/components/ui/utils",
    "ui": "#/components/ui",
    "lib": "#/components/ui",
    "hooks": "#/components/hooks"
  },
  "iconLibrary": "lucide"
}
